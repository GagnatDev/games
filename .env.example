# Base env for local development. Copy to `.env` (gitignored) and fill in.
# Shared by the backend (dotenv) and the frontend (Vite `envDir` points here).
#
# AUTH_MODE / VITE_DISABLE_AUTH are NOT set here — they come from the committed
# overlays `.env.development` (pnpm dev) and `.env.sidecar` (pnpm dev:sidecar).

# --- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres. Matches docker-compose.yml.
DATABASE_URL=postgresql://games:games@localhost:5432/games

# --- Auth ------------------------------------------------------------------
# Nothing to configure. `games` runs behind the homectl-auth-proxy sidecar, so
# every OAuth value (PUBLIC_AUTH_URL, AUTH_CLIENT_ID/SECRET, COOKIE_KEY,
# APP_BASE_URL, ...) lives on the sidecar container in k8s/deployment.yml. The
# app only reads the X-Homectl-* headers the sidecar injects.

# --- Web Push (VAPID) ------------------------------------------------------
# In production these come from the Terraform-managed `games-vapid-secrets`
# Secret (vapid = true in homectl-infra). Locally, generate a throwaway pair:
#   pnpm --filter @games/backend run vapid:generate
# Leave unset to run with push disabled — the app degrades gracefully.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@homectl.no

# --- Frontend (Vite) -------------------------------------------------------
# The VAPID public key is deliberately NOT a VITE_ var: it is a runtime value
# from a k8s Secret, and VITE_ vars are baked in at build time. The SPA fetches
# it from GET /api/push/public-key instead.
