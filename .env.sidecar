# Committed overlay for running with the auth sidecar in the loop, selected by
# `pnpm dev:sidecar`. No secrets.
#
# AUTH_MODE=sidecar makes the backend require the X-Homectl-* identity headers
# the homectl-auth-proxy injects, and turns off the SPA's dev bypass. It only
# works with the proxy actually in front of the app — run the proxy image with
# DEV_FAKE_IDENTITY (homectl-auth docs/sidecar/integration.md §7 option B):
#
#   docker run --rm -p 4180:4180 \
#     -e NODE_ENV=development \
#     -e PUBLIC_AUTH_URL=https://auth.homectl.no \
#     -e INTERNAL_AUTH_URL=http://localhost:9999 \
#     -e AUTH_CLIENT_ID=games -e AUTH_CLIENT_SECRET=dev \
#     -e APP_BASE_URL=http://localhost:4180 \
#     -e UPSTREAM=http://host.docker.internal:8080 \
#     -e COOKIE_KEY="$(openssl rand -base64 32)" \
#     -e DEV_FAKE_IDENTITY='{"sub":"dev-user","email":"dev@homectl.no","role":"player"}' \
#     rg.fr-par.scw.cloud/homectl/homectl-auth-proxy:latest
#
# ...then browse http://localhost:4180. For plain offline work use `pnpm dev`.
NODE_ENV=development
AUTH_MODE=sidecar
VITE_DISABLE_AUTH=false
