{
  "name": "@games/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ENV_FILE=.env.development tsx watch src/server.ts",
    "dev:sidecar": "ENV_FILE=.env.sidecar tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vapid:generate": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@games/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "kysely": "^0.28.7",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.1",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.12",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "testcontainers": "^11.7.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
